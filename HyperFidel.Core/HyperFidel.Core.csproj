<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HyperFidel.Core</AssemblyName>
    <RootNamespace>HyperFidel</RootNamespace>
    <Product>HyperFidel.Core</Product>
    <Authors>HyperFidel contributors, Björn Schlaack</Authors>
    <Copyright>Copyright © 2026 HyperFidel contributors; original Orynivo code © 2026 Björn Schlaack</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wuuwuu26/HyperFidel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lucene.Net"                  Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Analysis.Common"  Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.QueryParser"      Version="4.8.0-beta00018" />
    <PackageReference Include="Microsoft.Data.Sqlite"       Version="10.0.13" />
    <PackageReference Include="SkiaSharp"                   Version="3.119.4" />
    <PackageReference Include="TagLibSharp"                 Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Library\GenreTaxonomy.json" />
  </ItemGroup>

</Project>
