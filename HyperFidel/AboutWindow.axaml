<Window x:Class="HyperFidel.AboutWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_About}"
        Icon="avares://HyperFidel/Assets/HyperFidel.ico"
        Width="620"
        Height="720"
        MinWidth="540"
        MinHeight="620"
        Background="{DynamicResource AppContentBrush}"
        Foreground="{DynamicResource AppPrimaryTextBrush}">
    <Window.Styles>
        <Style Selector="TextBlock.license">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.aboutLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>
    <Grid Margin="22"
          RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Border Grid.Row="0"
                Height="110"
                ClipToBounds="True">
            <Image HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   Source="{DynamicResource AppAboutLogoSource}"
                   Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,0">
            <TextBlock FontWeight="SemiBold"
                       Text="{DynamicResource L_Author}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="HyperFidel contributors"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Original Orynivo author: Björn Schlaack"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Copyright © 2026 HyperFidel contributors; original Orynivo code © 2026 Björn Schlaack"/>
            <TextBlock x:Name="VersionTextBlock"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CheckForUpdatesButton"
                        Content="{DynamicResource L_CheckForUpdates}"
                        Click="CheckForUpdatesButton_OnClick"/>
                <Button x:Name="InstallUpdateButton"
                        IsVisible="False"
                        Content="{DynamicResource L_DownloadAndInstall}"
                        Click="InstallUpdateButton_OnClick"/>
            </StackPanel>
            <TextBlock x:Name="UpdateStatusTextBlock"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0" Spacing="7">
            <TextBlock FontWeight="SemiBold"
                       Text="{DynamicResource L_ProjectLinks}"/>
            <WrapPanel Orientation="Horizontal">
                <Button Classes="aboutLink"
                        Content="{DynamicResource L_GitHubRepository}"
                        Tag="https://github.com/wuuwuu26/HyperFidel"
                        Click="OpenLinkButton_OnClick"/>
                <Button Classes="aboutLink"
                        Content="{DynamicResource L_ReleasesLabel}"
                        Tag="https://github.com/wuuwuu26/HyperFidel/releases"
                        Click="OpenLinkButton_OnClick"/>
                <Button Classes="aboutLink"
                        Content="{DynamicResource L_ReportIssue}"
                        Tag="https://github.com/wuuwuu26/HyperFidel/issues"
                        Click="OpenLinkButton_OnClick"/>
                <Button Classes="aboutLink"
                        Content="{DynamicResource L_Documentation}"
                        Tag="https://github.com/wuuwuu26/HyperFidel/wiki"
                        Click="OpenLinkButton_OnClick"/>
                <Button Classes="aboutLink"
                        Content="{DynamicResource L_BasedOnOrynivo}"
                        Tag="https://github.com/bschlaack/Orynivo"
                        Click="OpenLinkButton_OnClick"/>
            </WrapPanel>
            <TextBlock x:Name="BuildInfoTextBlock"
                       FontSize="{DynamicResource FontSizeMeta}"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,22,0,10"
                       FontWeight="SemiBold"
                       Text="{DynamicResource L_Licenses}"/>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Classes="license"
                               FontWeight="SemiBold"
                               Text="HyperFidel — Apache License 2.0"/>
                    <TextBlock Classes="license"
                               Text="The HyperFidel name, wordmark, logo, and application icon are not granted as trademarks by the Apache License."/>
                    <TextBlock Classes="license" Text="cwASIO — MIT License"/>
                    <TextBlock Classes="license" Text="Avalonia 12.1.4 — MIT License"/>
                    <TextBlock Classes="license" Text="QRCoder 1.8.1 — MIT License"/>
                    <TextBlock Classes="license" Text="SkiaSharp 3.119.4 — MIT License"/>
                    <TextBlock Classes="license" Text="Lucene.NET 4.8.0-beta00018 — Apache License 2.0"/>
                    <TextBlock Classes="license" Text="ModelContextProtocol C# SDK 2.2.0 — Apache License 2.0"/>
                    <TextBlock Classes="license" Text="Microsoft.Data.Sqlite 10.0.13 — MIT License"/>
                    <TextBlock Classes="license" Text="NAudio 2.3.0 — MIT License"/>
                    <TextBlock Classes="license" Text="TagLibSharp 2.3.0 — LGPL-2.1-only"/>
                    <TextBlock Classes="license" Text="SQLitePCLRaw / e_sqlite3 2.1.13 — Apache License 2.0 / SQLite public domain dedication"/>
                    <TextBlock Classes="license" Text="FFmpeg — separate LGPL essentials executable; exact terms depend on the downloaded build"/>
                    <TextBlock Classes="license" Text="ASIO is a trademark and software of Steinberg Media Technologies GmbH. The optional Steinberg ASIO SDK is licensed separately and is not included in the repository."/>
                    <TextBlock Margin="0,8,0,0"
                               Classes="license"
                               Text="Complete notices and license texts: THIRD_PARTY_NOTICES.md and the licenses directory next to the HyperFidel executable."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
